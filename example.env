# Copy to <instance>.env and fill in. Never put passwords here; use RDS IAM auth or export PMP_DB_PASSWORD in the shell.
PMP_NS=<pmp-namespace>
PMP_DB_HOST=<rds-endpoint>
PMP_DB_NAME=<db-name>
PMP_DB_USER=<db-user>
AWS_REGION=<region>
PCLM_CLI=mx-pclm-cli
#PCLM_SVC=mx-privatecloud-license-manager
#PCLM_SECRET=pclm-admin
